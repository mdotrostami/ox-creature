{
  "schema_version": "0.1.0",
  "provider": "gapgpt",
  "base_url": "https://api.gapgpt.app/v1",
  "api_key_secret_name": "LLM_API_KEY",
  "model_discovery": {
    "enabled": true,
    "endpoint": "/models",
    "selection_policy": "deterministic_qwen_or_coder_preference",
    "runtime_may_choose_model": true
  },
  "budget": {
    "max_cost_usd_per_run": 0.25,
    "max_model_calls_per_task": 4,
    "max_retries_per_task": 2
  },
  "authority": {
    "llm_is_advisory": true,
    "llm_may_not_merge_release_delete_or_approve": true
  }
}
