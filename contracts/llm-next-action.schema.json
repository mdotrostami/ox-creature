{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ox-creature LLM Next Self-Build Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["continue", "ready_for_judgment", "sleep", "stop"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "delay_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "experience": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "oneOf": [
          { "required": ["content"] },
          { "required": ["content_base64"] }
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(apps|config|contracts|docs|flows|src|state)/"
          },
          "content": {
            "type": "string"
          },
          "content_base64": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      }
    }
  }
}
